// Smartphone E-Commerce schema (INFYHACKATHON 2.0)
// Paste this into: backend/prisma/schema.prisma (replace everything)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

// Pending -> Confirmed -> Processing -> Shipped -> Delivered
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String   // bcrypt hash, never plain text
  role      Role     @default(CUSTOMER)
  phone     String?
  createdAt DateTime @default(now())

  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orders        Order[]
  reviews       Review[]
}

// parentId lets us have subcategories (Budget, Mid-range, Flagship, Gaming, Camera)
model Category {
  id       Int        @id @default(autoincrement())
  name     String
  parentId Int?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children Category[] @relation("SubCategories")
  products Product[]
}

// Specs are normal columns: easy to filter and easy for AI to read
model Product {
  id          Int      @id @default(autoincrement())
  name        String
  brand       String
  description String
  price       Int      // in rupees
  discount    Int      @default(0) // percent
  stock       Int      @default(0)
  images      String[] // image URLs
  createdAt   DateTime @default(now())

  // specifications
  ram         Int      // GB
  storage     Int      // GB
  processor   String
  screen      Float    // inches
  battery     Int      // mAh
  rearCamera  String   // "50MP + 8MP"
  frontCamera String?  // "16MP"
  os          String?
  network     String?  // 5G / 4G
  weight      Int?     // grams

  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  reviews       Review[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
}

model Review {
  id        Int      @id @default(autoincrement())
  rating    Int      // 1 to 5
  comment   String?
  createdAt DateTime @default(now())

  userId    Int
  productId Int
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model WishlistItem {
  id        Int     @id @default(autoincrement())
  userId    Int
  productId Int
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

model CartItem {
  id        Int     @id @default(autoincrement())
  quantity  Int     @default(1)
  userId    Int
  productId Int
  user      User    @relation(fields: [userId], references: [id])
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
}

// Address is stored directly in the order (simple, no extra table)
model Order {
  id            Int         @id @default(autoincrement())
  status        OrderStatus @default(PENDING)
  totalAmount   Int
  paymentMethod String      // "SIMULATED_CARD", "SIMULATED_UPI", "COD"
  createdAt     DateTime    @default(now())

  // shipping address
  fullName String
  phone    String
  address  String
  city     String
  pincode  String

  userId Int
  user   User        @relation(fields: [userId], references: [id])
  items  OrderItem[]
}

// price is copied at order time, so later price change doesn't affect old orders
model OrderItem {
  id       Int @id @default(autoincrement())
  quantity Int
  price    Int

  orderId   Int
  productId Int
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id])
}
