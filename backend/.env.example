# Database connection string (Supabase / local PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/smartphonedb?schema=public"

# Secret key for JWT session signing
JWT_SECRET="super-secret-jwt-key-infyhackathon"

# Backend server port
PORT=5000

# Frontend URL for CORS configuration
CLIENT_URL="http://localhost:5173"

# Google Gemini API Key for INFY AI Assistant (optional / stage 9)
GEMINI_API_KEY="your-gemini-api-key-here"
